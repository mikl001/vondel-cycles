# Supabase — local dev values are printed by `npx supabase start`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Mollie (test mode key, starts with test_) — Phase 5
MOLLIE_API_KEY=

# Resend — Phase 5+; leave empty to use the console email adapter
RESEND_API_KEY=

# Public site URL (used for canonical URLs, webhooks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Abandoned-cart cron protection (Vercel cron sends it as a Bearer token)
CRON_SECRET=

# Rate limiting — required in production (multi-instance); in-memory locally
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Privacy-first analytics, loaded only after cookie consent
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
